{
  "expo": {
    "name": "GrowFast",
    "slug": "growfast-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "growfast",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/Growfast_Logo_WithoutBG.png",
    "splash": {
      "image": "./assets/Growfast_Logo_WithoutBG.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infystent.growfast"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Growfast_Logo_WithoutBG.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.infystent.growfast"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
